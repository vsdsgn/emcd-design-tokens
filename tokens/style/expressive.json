{
  "decor": {
    "light": {
      "$type": "boolean",
      "$value": true
    },
    "tint": {
      "$type": "boolean",
      "$value": true
    },
    "material": {
      "$type": "boolean",
      "$value": true
    },
    "nav-expressive": {
      "$type": "boolean",
      "$value": true
    },
    "nav-base": {
      "$type": "boolean",
      "$value": false
    }
  },
  "light": {
    "ambient": {
      "color": {
        "$type": "color",
        "$value": "{glow.brand}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "160px"
      }
    },
    "tint": {
      "$type": "color",
      "$value": "{brand.accent.tint}"
    },
    "status": {
      "neutral": {
        "$type": "color",
        "$value": "{glow.neutral}"
      },
      "attention": {
        "$type": "color",
        "$value": "{glow.attention}"
      },
      "error": {
        "$type": "color",
        "$value": "{glow.error}"
      },
      "success": {
        "$type": "color",
        "$value": "{glow.success}"
      },
      "brand": {
        "$type": "color",
        "$value": "{glow.brand}"
      }
    },
    "accent": {
      "blur": {
        "$type": "dimension",
        "$value": "16px"
      },
      "color": {
        "$type": "color",
        "$value": "{brand.accent.glow-strong}"
      }
    },
    "tint-end": {
      "$type": "color",
      "$value": "{brand.accent.tint-end}"
    }
  },
  "edge": {
    "hairline": {
      "$type": "color",
      "$value": "{border.glass}"
    },
    "accent": {
      "$type": "color",
      "$value": "{brand.accent.500}"
    },
    "highlight": {
      "$type": "color",
      "$value": "{color.alpha.white.32}"
    }
  },
  "material": {
    "regular": {
      "blur": {
        "$type": "dimension",
        "$value": "{effect.blur.glass-lg}"
      },
      "fill": {
        "$type": "color",
        "$value": "{surface.glass-regular}"
      }
    },
    "thin": {
      "fill": {
        "$type": "color",
        "$value": "{surface.glass-thin}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "{effect.blur.glass-md}"
      }
    },
    "thick": {
      "fill": {
        "$type": "color",
        "$value": "{surface.glass-thick}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "{effect.blur.glass-lg}"
      }
    },
    "scrim": {
      "$type": "color",
      "$value": "{surface.overlay}"
    },
    "edge-blur": {
      "$type": "dimension",
      "$value": "{effect.blur.edge}"
    }
  }
}
