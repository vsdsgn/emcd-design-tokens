{
  "style": {
    "decor": {
      "glow": {
        "$type": "boolean",
        "$value": true
      },
      "card-tint": {
        "$type": "boolean",
        "$value": true
      },
      "glass": {
        "$type": "boolean",
        "$value": true
      }
    },
    "glow": {
      "color": {
        "$type": "color",
        "$value": "{brand.accent.glow}"
      },
      "blur": {
        "$type": "dimension",
        "$value": "160px"
      },
      "neutral": {
        "$type": "color",
        "$value": "{glow.neutral}"
      },
      "attention": {
        "$type": "color",
        "$value": "{color.alpha.amber.40}"
      },
      "error": {
        "$type": "color",
        "$value": "{color.alpha.red.40}"
      },
      "success": {
        "$type": "color",
        "$value": "{color.alpha.green.40}"
      },
      "brand": {
        "$type": "color",
        "$value": "{brand.accent.glow-strong}"
      }
    },
    "card": {
      "tint": {
        "$type": "color",
        "$value": "{brand.accent.tint}"
      },
      "border": {
        "$type": "color",
        "$value": "{border.glass}"
      }
    },
    "edge": {
      "accent": {
        "$type": "color",
        "$value": "{brand.accent.500}"
      },
      "highlight": {
        "$type": "color",
        "$value": "{color.alpha.white.32}"
      }
    },
    "glass": {
      "blur": {
        "$type": "dimension",
        "$value": "{effect.blur.glass-lg}"
      }
    }
  }
}
