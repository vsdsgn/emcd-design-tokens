{
  "space": {
    "none": {
      "$type": "dimension",
      "$value": "{dimension.x0}"
    },
    "3xs": {
      "$type": "dimension",
      "$value": "{dimension.x0-125}"
    },
    "2xs": {
      "$type": "dimension",
      "$value": "{dimension.x0-25}"
    },
    "xs": {
      "$type": "dimension",
      "$value": "{dimension.x0-5}"
    },
    "sm": {
      "$type": "dimension",
      "$value": "{dimension.x0-75}"
    },
    "md": {
      "$type": "dimension",
      "$value": "{dimension.x1}"
    },
    "lg": {
      "$type": "dimension",
      "$value": "{dimension.x1-5}"
    },
    "xl": {
      "$type": "dimension",
      "$value": "{dimension.x2}"
    },
    "2xl": {
      "$type": "dimension",
      "$value": "{dimension.x3}"
    },
    "3xl": {
      "$type": "dimension",
      "$value": "{dimension.x4}"
    }
  },
  "control": {
    "height": {
      "sm": {
        "$type": "dimension",
        "$value": "{dimension.x2}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{dimension.x2-5}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{dimension.x3}"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{dimension.x3-5}"
      }
    },
    "padding-x": {
      "sm": {
        "$type": "dimension",
        "$value": "{dimension.x0-625}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{dimension.x0-875}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{dimension.x1}"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{dimension.x1-25}"
      }
    },
    "gap": {
      "$type": "dimension",
      "$value": "{dimension.x0-5}"
    }
  },
  "touch": {
    "min": {
      "$type": "dimension",
      "$value": "{dimension.x1-5}"
    },
    "is-coarse": {
      "$type": "boolean",
      "$value": false
    },
    "is-fine": {
      "$type": "boolean",
      "$value": true
    }
  },
  "icon": {
    "size": {
      "sm": {
        "$type": "dimension",
        "$value": "{dimension.x1}"
      },
      "md": {
        "$type": "dimension",
        "$value": "{dimension.x1-25}"
      },
      "lg": {
        "$type": "dimension",
        "$value": "{dimension.x1-5}"
      },
      "xl": {
        "$type": "dimension",
        "$value": "{dimension.x2}"
      },
      "inline": {
        "$type": "dimension",
        "$value": "{dimension.x1}"
      },
      "control": {
        "$type": "dimension",
        "$value": "{dimension.x1-25}"
      },
      "nav": {
        "$type": "dimension",
        "$value": "{dimension.x1-5}"
      }
    },
    "stroke": {
      "regular": {
        "$type": "dimension",
        "$value": "{stroke.1-5}"
      },
      "strong": {
        "$type": "dimension",
        "$value": "{stroke.2}"
      }
    }
  },
  "list": {
    "item-height": {
      "$type": "dimension",
      "$value": "{dimension.x3-5}"
    }
  },
  "nav": {
    "header-height": {
      "$type": "dimension",
      "$value": "{dimension.x4-5}"
    },
    "bar-height": {
      "$type": "dimension",
      "$value": "{dimension.x3-5}"
    }
  },
  "card": {
    "padding": {
      "$type": "dimension",
      "$value": "{dimension.x1-5}"
    },
    "gap": {
      "$type": "dimension",
      "$value": "{dimension.x1}"
    }
  },
  "modal": {
    "padding": {
      "$type": "dimension",
      "$value": "{dimension.x2}"
    }
  },
  "radius": {
    "control": {
      "$type": "dimension",
      "$value": "{brand.radius.md}"
    },
    "container": {
      "$type": "dimension",
      "$value": "{brand.radius.lg}"
    },
    "surface": {
      "$type": "dimension",
      "$value": "{brand.radius.xl}"
    },
    "chip": {
      "$type": "dimension",
      "$value": "{brand.radius.full}"
    },
    "inner": {
      "$type": "dimension",
      "$value": "{brand.radius.sm}"
    },
    "control-sm": {
      "$type": "dimension",
      "$value": "{brand.radius.control-sm}"
    },
    "focus-ring-sm": {
      "$type": "dimension",
      "$value": "{brand.radius.focus-ring-sm}"
    },
    "focus-ring": {
      "$type": "dimension",
      "$value": "{brand.radius.focus-ring}"
    }
  },
  "border": {
    "width": {
      "default": {
        "$type": "dimension",
        "$value": "{stroke.1}"
      },
      "focus": {
        "$type": "dimension",
        "$value": "{stroke.2}"
      },
      "focus-ring": {
        "$type": "dimension",
        "$value": "{dimension.x0-25}"
      }
    }
  },
  "effect": {
    "blur": {
      "glass-sm": {
        "$type": "dimension",
        "$value": "{blur.8}"
      },
      "glass-md": {
        "$type": "dimension",
        "$value": "{blur.16}"
      },
      "glass-lg": {
        "$type": "dimension",
        "$value": "{blur.32}"
      },
      "edge": {
        "$type": "dimension",
        "$value": "{blur.24}"
      },
      "backdrop": {
        "$type": "dimension",
        "$value": "{blur.8}"
      }
    }
  },
  "layout": {
    "edge-fade": {
      "$type": "dimension",
      "$value": "{dimension.x3}"
    }
  },
  "focus": {
    "offset": {
      "$type": "dimension",
      "$value": "{dimension.x0}"
    }
  },
  "motion": {
    "duration": {
      "feedback": {
        "$type": "duration",
        "$value": "{duration.fast}"
      },
      "enter": {
        "$type": "duration",
        "$value": "{duration.base}"
      },
      "exit": {
        "$type": "duration",
        "$value": "{duration.fast}"
      },
      "overlay": {
        "$type": "duration",
        "$value": "{duration.base}"
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": "{easing.standard}"
      },
      "enter": {
        "$type": "cubicBezier",
        "$value": "{easing.out}"
      }
    },
    "scale": {
      "press": {
        "$type": "number",
        "$value": "{scale.press}"
      }
    }
  }
}
